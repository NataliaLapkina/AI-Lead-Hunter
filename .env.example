# Google OAuth 2.0 Client ID (Web application)
# https://console.cloud.google.com/apis/credentials
VITE_GOOGLE_CLIENT_ID=

# Public app URL for OAuth redirect (production)
VITE_APP_URL=http://localhost:5173

# Temporary local Business id until Auth/Membership exists.
# Use a real PostgreSQL Business.id in local .env. Do not commit a real value.
VITE_DEV_BUSINESS_ID=
